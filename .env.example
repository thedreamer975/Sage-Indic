# SAGE-Indic Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# Never commit real API keys.

SAGE_ENV=development
LOG_LEVEL=INFO

# Optional directory overrides (defaults to project paths)
# SAGE_DATA_DIR=data
# SAGE_CONFIGS_DIR=configs
# SAGE_EXPERIMENTS_DIR=experiments

# Frozen SAGE tokenizer used by the demo retriever
# SAGE_TOKENIZER_MODEL=experiments/saved_models/sage_4000.json

# ---------------------------------------------------------------------------
# Optional LLM layer (deterministic composition always remains available)
# ---------------------------------------------------------------------------
# auto | true | false.  "false" disables provider probing and LLM use entirely.
SAGE_LLM_ENABLED=auto
SAGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
SAGE_LLM_MODEL=llama3.2:1b
SAGE_LLM_TIMEOUT=25
SAGE_LLM_MAX_TOKENS=256
SAGE_LLM_TEMPERATURE=0.0

# Name of the environment variable holding the API key, if a remote
# OpenAI-compatible provider is used. Leave empty for Ollama (no key).
# SAGE_LLM_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (frontend/.env.local) -- optional
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000
